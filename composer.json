{
    "name": "litetracker/litetracker",
    "description": "LiteTracker — PHP BitTorrent tracker",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1 <8.5"
    },
    "autoload": {
        "psr-4": {
            "LiteTracker\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
