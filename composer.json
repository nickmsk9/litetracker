{
    "name": "litetracker/litetracker",
    "description": "LiteTracker — PHP BitTorrent tracker",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LiteTracker\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiteTracker\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
