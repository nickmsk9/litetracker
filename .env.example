# LiteTracker — environment configuration template
# Copy to .env and adjust values for your environment.
# Never commit .env to version control.

# -------------------------------------------------------
# Application
# -------------------------------------------------------
LITETRACKER_HOST_HTTP_PORT=8094
LITETRACKER_HOST_HTTPS_PORT=443
LITETRACKER_PUBLIC_SCHEME=http
LITETRACKER_PUBLIC_HOST=localhost:8094
LITETRACKER_ANNOUNCE_HOST=localhost:8094
LITETRACKER_ANNOUNCE_URL=http://localhost:8094/announce.php

# -------------------------------------------------------
# Database — REQUIRED: change before going to production
# -------------------------------------------------------
LITETRACKER_DB_PASSWORD=litetracker_local

# -------------------------------------------------------
# Cron token — REQUIRED: change before going to production
# -------------------------------------------------------
LITETRACKER_CRON_TOKEN=litetracker-local-cron-token

# -------------------------------------------------------
# Captcha (optional)
# -------------------------------------------------------
LITETRACKER_CAPTCHA_ENABLED=0
LITETRACKER_CAPTCHA_SIGNUP=1
LITETRACKER_CAPTCHA_LOGIN=0
LITETRACKER_CAPTCHA_DOWNLOAD=0
